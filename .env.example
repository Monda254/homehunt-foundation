# ==============================================================================
# HOMEHUNT PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION MATRIX
# ==============================================================================

# Core Application Settings
APP_ENV=production
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Security & Session Secrets
JWT_SECRET=your-jwt-secret-at-least-32-chars-long
SESSION_SECRET=your-session-secret-at-least-32-chars-long

# M-Pesa Daraja Payment Gateway Configuration
MPESA_ENVIRONMENT=sandbox # Set to 'production' for live deployment
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
MPESA_PASSKEY=your-daraja-stk-passkey
MPESA_BUSINESS_SHORTCODE=174379 # Your Paybill / Till Number
MPESA_CALLBACK_URL=https://api.homehunt.co.ke/api/v1/payments/mpesa/callback

# Notification Providers
RESEND_API_KEY=re_your_resend_api_key_here
AFRICASTALKING_API_KEY=your_africas_talking_api_key
AFRICASTALKING_USERNAME=sandbox

# Optional Generative AI Provider Integration
OPENAI_API_KEY=sk-your-openai-api-key-here
GEMINI_API_KEY=your-google-gemini-api-key-here

# Optional Redis Rate Limiting & Lock Store
REDIS_URL=redis://default:password@localhost:6379
